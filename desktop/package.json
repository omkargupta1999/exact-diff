{
  "name": "exact-diff-desktop",
  "productName": "Exact Diff",
  "desktopName": "exact-diff.desktop",
  "version": "1.0.0",
  "description": "Exact Diff — Offline Text Compare (desktop app).",
  "homepage": "https://github.com/YOUR-USERNAME/exact-diff",
  "main": "main.js",
  "author": "omkargupta1999",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "copy-app": "node scripts/copy-app.mjs",
    "start": "node scripts/copy-app.mjs && electron .",
    "dist:linux": "node scripts/copy-app.mjs && electron-builder --linux AppImage deb --publish never",
    "dist:win": "node scripts/copy-app.mjs && electron-builder --win nsis portable --publish never",
    "dist:win-on-linux": "node scripts/copy-app.mjs && electron-builder --win portable zip --publish never -c.win.signAndEditExecutable=false",
    "dist:mac": "node scripts/copy-app.mjs && electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:rpm": "node scripts/copy-app.mjs && electron-builder --linux rpm --publish never"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.YOUR-USERNAME.exactdiff",
    "productName": "Exact Diff",
    "copyright": "Copyright © 2026 omkargupta1999. MIT licence.",
    "artifactName": "exact-diff-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "app/index.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "publish": null,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Exact Diff",
      "artifactName": "exact-diff-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "exact-diff-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "omkargupta1999",
      "executableName": "exact-diff",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    }
  }
}
